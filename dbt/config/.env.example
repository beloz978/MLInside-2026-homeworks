# Несекретные настройки путей. Все пути — относительно корня этого репозитория
# (абсолютные тоже работают). Секреты (пароли БД и т.п.) кладите в .env.local — он не коммитится.

# Каталог с CSV Olist. Пусто → скачать через kagglehub.
OLIST_CSV_DIR=

# Проект dbt студента и каталог с его profiles.yml. Мастер (`make wizard`) пишет сюда абсолютные пути.
HW_DBT_PROJECT_DIR=
HW_DBT_PROFILES_DIR=
HW_DBT_PROFILE=olist

# Какие target проверять скриптом доступности СУБД (через запятую; пусто = все).
HW_DBT_TARGETS=duckdb
# Target для `just check-dbt` (пусто = default из profiles.yml).
HW_DBT_TARGET=
# Второй таргет для 10 баллов (имя output в profiles.yml: postgres | clickhouse). Пусто → первый не-duckdb.
HW_SECOND_TARGET=

# GitHub: репозиторий с PR (owner/name) и номер PR. Пусто = взять из git remote / PR текущей ветки.
# Токен (GH_TOKEN) — в .env.local или через `gh auth login`. Заполняет `make wizard`.
HW_GH_REPO=
HW_GH_PR=

# Файл DuckDB с raw-слоем и эталонные контрольные цифры.
OLIST_DUCKDB_PATH=data/olist.duckdb
CONTROL_FIGURES_JSON=data/control_figures.json
