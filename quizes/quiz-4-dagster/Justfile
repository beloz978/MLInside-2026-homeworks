# Запуск теста из этого каталога: `just` (= just run). Общий код — ../src.
dir := justfile_directory()
src := dir / "../src"

default: run

# Пройти тест (lang: ru или en; без него язык спросят при старте)
run lang="":
    uv run --with questionary --with pyyaml python {{src}}/quiz.py {{dir}} {{ if lang != "" { "--lang " + lang } else { "" } }}

# quiz.<язык>.md → quiz.yaml с самопроверкой (section — заголовок раздела, если нужен только он)
yaml section="":
    uv run --with pyyaml python {{src}}/md2yaml.py {{dir}} {{ if section != "" { quote(section) } else { "" } }}

# Последние логи прохождений
logs:
    @ls -t {{dir}}/logs/*.jsonl 2>/dev/null | head -10 || echo "логов пока нет"

# Тесты кода (общие для всех тестов)
test:
    uv run --with questionary --with pyyaml --with pytest pytest {{src}}/test_quiz.py
