# Несекретные настройки путей для автопроверки ДЗ по Dagster. Пути — относительно каталога Dagster/ (абсолютные тоже работают).
# Секреты (GH_TOKEN и т.п.) — в .env.local, он не коммитится. Значений по умолчанию в скриптах нет: пустой ключ — ошибка.

# Проект Dagster студента (каталог с pyproject.toml) и модуль с Definitions, например olist_dagster.definitions.
HW_DAGSTER_PROJECT_DIR=
HW_DAGSTER_MODULE=

# Интерпретатор проекта (там стоит dagster). Пусто → .venv проекта, иначе текущий.
HW_DAGSTER_PYTHON=
# Готовый DAGSTER_HOME с результатами запуска — только для `check_hw.py --no-run`.
HW_DAGSTER_HOME=

# Файл DuckDB, в который проект грузит raw и витрины.
OLIST_DUCKDB_PATH=data/olist.duckdb

# GitHub: репозиторий с PR (owner/name) и номер PR. Пусто = взять из git remote / PR текущей ветки.
# Токен (GH_TOKEN) — в .env.local или через `gh auth login`.
HW_GH_REPO=
HW_GH_PR=
